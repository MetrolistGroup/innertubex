+    private suspend fun probeFirstMedia(
+        httpClient: HttpClient,
+        resource: PlaybackResource,
+    ): MediaProbe =
+        try {
+            withTimeoutOrNull(FIRST_MEDIA_TIMEOUT_MS) {
+                resource.sabrBootstrap?.let { bootstrap ->
+                    var status: Int? = null
+                    val bytes =
+                        SabrAudioStream(
+                            httpClient = httpClient,
+                            bootstrap = bootstrap,
+                            onResponse = { status = it.httpStatus },
+                        ).chunks().first { !it.isInitialization && it.data.isNotEmpty() }.data.size
+                    return@withTimeoutOrNull MediaProbe(status ?: 200, bytes)
+                }
+                httpClient
+                    .prepareGet(resource.url) {
+                        resource.headers.forEach { (name, value) -> header(name, value) }
+                        header(HttpHeaders.Range, "bytes=0-${FIRST_MEDIA_RANGE_BYTES - 1}")
+                        timeout {
+                            requestTimeoutMillis = FIRST_MEDIA_TIMEOUT_MS
+                            connectTimeoutMillis = FIRST_MEDIA_TIMEOUT_MS
+                            socketTimeoutMillis = FIRST_MEDIA_TIMEOUT_MS
+                        }
+                    }.execute { response ->
+                        val channel = response.bodyAsChannel()
+                        val bytes = channel.readAvailable(ByteArray(1))
+                        channel.cancel()
+                        check(response.status.value in 200..299) { "media HTTP ${response.status.value}" }
+                        check(bytes > 0) { "media empty" }
+                        MediaProbe(response.status.value, bytes)
+                    }
+            } ?: error("first-media deadline exceeded")
+        } catch (error: CancellationException) {
+            throw error
+        } catch (error: Throwable) {
+            throw IllegalStateException("first media ${error::class.simpleName}")
+        }
+
+    private suspend fun decodeAudio(
+        httpClient: HttpClient,
+        resource: PlaybackResource,
+    ): DecodeProbe =
+        withTimeoutOrNull(DECODE_TIMEOUT_MS) {
+            runInterruptible(Dispatchers.IO) { decodeAudioBlocking(httpClient, resource) }
+        } ?: DecodeProbe(error = "decode-total:timeout")
+
+    private fun decodeAudioBlocking(
+        httpClient: HttpClient,
+        resource: PlaybackResource,
+    ): DecodeProbe {
+        val started = TimeSource.Monotonic.markNow()
+        val input =
+            resource.sabrBootstrap?.let { bootstrap ->
+                SabrInputStream(resource.contentLengthBytes, streamFactory = { initialPosition, playbackClock ->
+                    SabrAudioStream(
+                        httpClient,
+                        bootstrap,
+                        initialPlayerTimeMs = initialPosition,
+                        playbackPositionMs = playbackClock,
+                    ).chunks()
+                })
+            } ?: HttpRangeInputStream(url = resource.url, requestHeaders = resource.headers, mediaSize = resource.contentLengthBytes ?: 0L)
+        var stage = "open"
+        var sampleRate: Int? = null
+        var channels: Int? = null
+        var firstPcmMs: Long? = null
+        var fullDecodeMs: Long? = null
+        var seekFirstPcmMs: Long? = null
+        var decodedPositionMs: Long? = null
+        var seekPositionMs: Long? = null
+        return try {
+            input.use {
+                val decoder = AudioDecoder(it, 0)
+                try {
+                    stage = "format"
+                    val discoveredSampleRate = decoder.sampleRate
+                    val discoveredChannels = decoder.audioChannels
+                    sampleRate = discoveredSampleRate
+                    channels = discoveredChannels
+                    check(discoveredSampleRate > 0 && discoveredChannels > 0) { "audio format unavailable" }
+                    val targetBytes = discoveredSampleRate.toLong() * discoveredChannels * 2L * DECODE_SECONDS
+                    stage = "first-pcm"
+                    checkNotNull(decoder.readPCMFrame()) { "no PCM" }
+                    firstPcmMs = started.elapsedNow().inWholeMilliseconds
+                    val seekStarted = TimeSource.Monotonic.markNow()
+                    stage = "seek"
+                    decoder.seekTo(SEEK_TARGET_MS)
+                    var decodedBytes = checkNotNull(decoder.readPCMFrame()) { "no seek PCM" }.size.toLong()
+                    seekFirstPcmMs = seekStarted.elapsedNow().inWholeMilliseconds
+                    val observedSeekPositionMs = decoder.getCurrentPosition()
+                    seekPositionMs = observedSeekPositionMs
+                    check(observedSeekPositionMs in MIN_SEEK_POSITION_MS..MAX_SEEK_POSITION_MS) { "seek clock outside tolerance" }
+                    val playbackStartedNanos = System.nanoTime()
+                    val playbackStartedPositionMs = observedSeekPositionMs
+                    decodedPositionMs = observedSeekPositionMs
+                    stage = "decode-${DECODE_SECONDS}s"
+                    while (decodedBytes < targetBytes) {
+                        val frame = decoder.readPCMFrame()
+                        if (frame == null) {
+                            return DecodeProbe(
+                                sampleRate = sampleRate,
+                                channels = channels,
+                                firstPcmMs = firstPcmMs,
+                                seekFirstPcmMs = seekFirstPcmMs,
+                                decodedPositionMs = decodedPositionMs,
+                                seekPositionMs = seekPositionMs,
+                                error = "$stage:eof:${classifyStreamFailure(decoder.streamFailure)}",
+                            )
+                        }
+                        decodedBytes += frame.size
+                        val observedDecodedPositionMs = decoder.getCurrentPosition()
+                        decodedPositionMs = observedDecodedPositionMs
+                        pacePlaybackClock(playbackStartedNanos, observedDecodedPositionMs - playbackStartedPositionMs)
+                    }
+                    check(checkNotNull(decodedPositionMs) >= SEEK_TARGET_MS + MIN_DECODED_POSITION_MS) {
+                        "decoded clock did not reach target"
+                    }
+                    fullDecodeMs = started.elapsedNow().inWholeMilliseconds
+                    DecodeProbe(
+                        sampleRate = sampleRate,
+                        channels = channels,
+                        firstPcmMs = firstPcmMs,
+                        fullDecodeMs = fullDecodeMs,
+                        seekFirstPcmMs = seekFirstPcmMs,
+                        decodedPositionMs = decodedPositionMs,
+                        seekPositionMs = seekPositionMs,
+                    )
+                } finally {
+                    decoder.close()
+                }
+            }
+        } catch (error: Throwable) {
+            if (Thread.currentThread().isInterrupted) throw error
+            DecodeProbe(
+                sampleRate = sampleRate,
+                channels = channels,
+                firstPcmMs = firstPcmMs,
+                fullDecodeMs = fullDecodeMs,
+                seekFirstPcmMs = seekFirstPcmMs,
+                decodedPositionMs = decodedPositionMs,
+                seekPositionMs = seekPositionMs,
+                error = "$stage:${error::class.simpleName ?: "Throwable"}",
+            )
+        }
+    }
+
+    private fun classifyStreamFailure(error: Throwable?): String {
+        var current = error
+        while (current != null) {
+            val message = current.message.orEmpty()
+            when {
+                "made no" in message -> return "no-progress"
+                message.startsWith("Incomplete SABR stream") -> return "incomplete-stream"
+                "attestation" in message -> return "attestation-required"
+                message.startsWith("SABR request failed") -> return "http-failure"
+            }
+            current = current.cause
+        }
+        return error?.javaClass?.simpleName ?: "none"
+    }
+
+    private fun pacePlaybackClock(
+        playbackStartedNanos: Long,
+        positionMs: Long,
+    ) {
+        val elapsedMs = (System.nanoTime() - playbackStartedNanos) / 1_000_000L
+        val sleepMs = positionMs - PLAYBACK_CLOCK_LEAD_MS - elapsedMs
+        if (sleepMs > 0L) Thread.sleep(sleepMs)
+    }
