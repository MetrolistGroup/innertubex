+@OptIn(ExperimentalSabrApi::class)
+class LivePremiumAbBenchmarkTest {
+    @Test
+    fun runSanitizedPremiumAbBenchmark() =
+        runBlocking {
+            if (!LiveInnerTubeSuite.liveBenchmarksEnabled()) return@runBlocking
+            require(LiveInnerTubeSuite.benchmarkIterations() >= 1) { "Live AB benchmark requires at least one iteration" }
+
+            withLiveInnerTubeClient { httpClient, innerTube ->
+                val label = env("INNERTUBE_BENCHMARK_LABEL", "unknown")
+                val requestedPremiumHint = System.getenv("INNERTUBE_BENCHMARK_PREMIUM_HINT").toBoolean()
+                val forcedProfile = System.getenv("INNERTUBE_BENCHMARK_PROFILE")?.takeIf { it.isNotBlank() }
+                val auth = probeAuthentication(innerTube)
+                val tracker = TransformTracker()
+                val logger = InnerTubeLogger { event -> tracker.observe(event.tag, event.message) }
+                val configStore = RemotePlayerConfigStore(httpClient, MetrolistPlayerConfigRepository, logger)
+                val cipherService = YouTubeCipherService(httpClient, configStore, logger)
+                val tokenProvider = DesktopTokenProvider()
+                val benchmarkExtractor =
+                    InnerTubeExtractor(
+                        configParser = YtConfigParserImpl(httpClient, innerTube, configStore, logger),
+                        cipherService = cipherService,
+                        innerTube = innerTube,
+                        fallbackStrategy = ContentAwareFallbackStrategy(),
+                        tokenProvider = tokenProvider,
+                        logger = logger,
+                    )
+                val iterations = LiveInnerTubeSuite.benchmarkIterations()
+                val decodeEnabled = System.getenv("INNERTUBE_BENCHMARK_DECODE").toBoolean()
+                val decodeEach = System.getenv("INNERTUBE_BENCHMARK_DECODE_EACH").toBoolean()
+                val samples = LiveInnerTubeSuite.liveContentTypes().map { it.name to it.streams.first() }
+                val rows = mutableListOf<Row>()
+                var streamNumber = 0
+                val tokenPrewarmMs =
+                    if (System.getenv("INNERTUBE_BENCHMARK_PREWARM").toBoolean()) {
+                        val start = TimeSource.Monotonic.markNow()
+                        tokenProvider.prewarm(innerTube.sessionSnapshot().cookie)
+                        start.elapsedNow().inWholeMilliseconds
+                    } else {
+                        null
+                    }
+                val extractorPrewarmMs =
+                    if (System.getenv("INNERTUBE_BENCHMARK_PREWARM").toBoolean()) {
+                        val start = TimeSource.Monotonic.markNow()
+                        benchmarkExtractor.prewarm()
+                        start.elapsedNow().inWholeMilliseconds
+                    } else {
+                        null
+                    }
+
+                try {
+                    samples.forEachIndexed { sampleIndex, (type, stream) ->
+                        if (sampleIndex > 0) LiveInnerTubeSuite.pauseBetweenGroups("$type group")
+                        repeat(iterations) { iterationIndex ->
+                            if (streamNumber++ > 0) LiveInnerTubeSuite.pauseBetweenStreams("$type iteration ${iterationIndex + 1}")
+                            val baseHints = forcedProfile?.let { stream.hints.copy(playbackClientOverrideId = it) } ?: stream.hints
+                            val hints = applyPremiumHint(baseHints, requestedPremiumHint)
+                            val resolver = DefaultStreamResolver(benchmarkExtractor, innerTube, tokenProvider = tokenProvider)
+                            val row =
+                                try {
+                                    runOne(
+                                        httpClient = httpClient,
+                                        resolver = resolver,
+                                        tracker = tracker,
+                                        type = type,
+                                        iteration = iterationIndex + 1,
+                                        processPhase = if (sampleIndex == 0 && iterationIndex == 0) "process-first" else "process-warm",
+                                        profilePhase = if (iterationIndex == 0) "profile-first" else "profile-repeat",
+                                        videoId = stream.videoId,
+                                        hints = hints,
+                                        decode = decodeEnabled && (decodeEach || iterationIndex == 0),
+                                    )
+                                } finally {
+                                    resolver.close()
+                                }
+                            rows += row
+                        }
+                    }
+                } finally {
+                    try {
+                        cipherService.dispose()
+                    } finally {
+                        tokenProvider.close()
+                    }
+                }
+
+                val premiumHintApplied =
+                    requestedPremiumHint && samples
+                        .firstOrNull()
+                        ?.second
+                        ?.hints
+                        ?.let { applyPremiumHint(it, true) !== it } == true
+                writeReports(
+                    label = label,
+                    auth = auth,
+                    requestedPremiumHint = requestedPremiumHint,
+                    premiumHintApplied = premiumHintApplied,
+                    forcedProfile = forcedProfile,
+                    iterations = iterations,
+                    tokenPrewarmMs = tokenPrewarmMs,
+                    extractorPrewarmMs = extractorPrewarmMs,
+                    rows = rows,
+                )
+                println(summary(label, auth, requestedPremiumHint, premiumHintApplied, tokenPrewarmMs, extractorPrewarmMs, rows))
+            }
+        }
