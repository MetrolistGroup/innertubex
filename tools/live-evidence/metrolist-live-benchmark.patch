+        extractorPrewarmMs: Long?,
+        rows: List<Row>,
+    ) {
+        val dir =
+            System
+                .getenv("INNERTUBE_BENCHMARK_REPORT_DIR")
+                ?.takeIf(String::isNotBlank)
+                ?.let(::File)
+                ?.also(File::mkdirs)
+                ?: LiveInnerTubeSuite.benchmarkReportDir().also(File::mkdirs)
+        val safeLabel = label.replace(Regex("[^A-Za-z0-9_-]"), "_")
+        dir.resolve("playback-ab-$safeLabel.csv").writeText(
+            buildString {
+                appendLine(Row.HEADER)
+                rows.forEach { appendLine(it.csv()) }
+            },
+        )
+        dir.resolve("playback-ab-$safeLabel.json").writeText(
+            buildString {
+                appendLine("{")
+                appendLine("  \"implementation\": ${json(label)},")
+                appendLine("  \"measured_at_utc\": ${json(Instant.now().toString())},")
+                appendLine("  \"app_revision\": ${json(env("INNERTUBE_APP_REVISION", "unknown"))},")
+                appendLine("  \"library_revision\": ${json(env("INNERTUBE_LIBRARY_REVISION", "unknown"))},")
+                appendLine("  \"arm\": ${json(env("INNERTUBE_BENCHMARK_ARM", "unknown"))},")
+                appendLine("  \"pair_index\": ${json(env("INNERTUBE_BENCHMARK_PAIR", "unknown"))},")
+                appendLine("  \"order_position\": ${json(env("INNERTUBE_BENCHMARK_ORDER", "unknown"))},")
+                appendLine("  \"audio_quality\": \"HIGH\",")
+                appendLine("  \"iterations\": $iterations,")
+                appendLine("  \"credentials_present\": ${auth.credentialsPresent},")
+                appendLine("  \"authentication_endpoint_status\": ${auth.status ?: "null"},")
+                appendLine("  \"authenticated_account_menu_observed\": ${auth.accountMenuObserved},")
+                appendLine("  \"authentication_verified\": ${auth.verified},")
+                appendLine("  \"premium_entitlement\": \"not_observed\",")
+                appendLine("  \"premium_hint_role\": \"explicit_hypothesis_only\",")
+                appendLine("  \"premium_hint_requested\": $requestedPremiumHint,")
+                appendLine("  \"premium_hint_applied\": $premiumHintApplied,")
+                appendLine("  \"forced_profile\": ${json(forcedProfile)},")
+                appendLine("  \"token_prewarm_ms\": ${tokenPrewarmMs ?: "null"},")
+                appendLine("  \"extractor_prewarm_ms\": ${extractorPrewarmMs ?: "null"},")
+                appendLine("  \"rows\": [")
+                rows.forEachIndexed { index, row ->
+                    append("    ${row.json()}")
+                    appendLine(if (index + 1 == rows.size) "" else ",")
+                }
+                appendLine("  ]")
+                appendLine("}")
+            },
+        )
+    }
