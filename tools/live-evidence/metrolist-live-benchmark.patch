+        extractorPrewarmMs: Long?,
+        rows: List<Row>,
+    ): String =
+        buildString {
+            appendLine(
+                "LIVE_AB implementation=$label quality=HIGH credentialsPresent=${auth.credentialsPresent} " +
+                    "authMenuObserved=${auth.accountMenuObserved} authVerified=${auth.verified} authStatus=${auth.status ?: "unknown"} " +
+                    "premiumEntitlement=not-observed premiumHintRequested=$requestedPremiumHint premiumHintApplied=$premiumHintApplied " +
+                    "tokenPrewarmMs=${tokenPrewarmMs ?: "none"} extractorPrewarmMs=${extractorPrewarmMs ?: "none"}",
+            )
+            rows.forEach { row ->
+                appendLine(
+                    "ROW type=${row.type} iteration=${row.iteration} processPhase=${row.processPhase} " +
+                        "profilePhase=${row.profilePhase} resolve=${row.resolveMs ?: "na"}ms " +
+                        "firstMedia=${row.firstMediaMs ?: "na"}ms total=${row.timeToFirstMediaMs ?: "na"}ms " +
+                        "cache=${row.cacheMs ?: "na"}ms client=${row.client ?: "na"} profile=${row.profile ?: "na"} " +
+                        "transport=${row.transport ?: "na"} itag=${row.itag ?: "na"} bitrate=${row.bitrate ?: "na"} " +
+                        "sampleRate=${row.sampleRate ?: "na"} channels=${row.audioChannels ?: "na"} " +
+                        "n=${row.nTransform} cipher=${row.cipherTransform} po=${row.usedPoToken} " +
+                        "attempts=${row.attempts} hops=${row.hops} decode30=${row.decoded30sMs ?: "na"}ms " +
+                        "decodedPosition=${row.decodedPositionMs ?: "na"}ms seek=${row.seekFirstPcmMs ?: "na"}ms " +
+                        "seekPosition=${row.seekPositionMs ?: "na"}ms error=${row.error ?: "none"}",
+                )
+            }
+        }
