+    private fun env(
+        name: String,
+        default: String,
+    ): String = System.getenv(name)?.takeIf { it.isNotBlank() } ?: default
+
+    private data class AuthProbe(
+        val credentialsPresent: Boolean,
+        val status: Int?,
+        val accountMenuObserved: Boolean,
+    ) {
+        val verified: Boolean = credentialsPresent && status in 200..299 && accountMenuObserved
+    }
+
+    private data class MediaProbe(
+        val status: Int,
+        val bytes: Int,
+    )
+
+    private data class DecodeProbe(
+        val sampleRate: Int? = null,
+        val channels: Int? = null,
+        val firstPcmMs: Long? = null,
+        val fullDecodeMs: Long? = null,
+        val seekFirstPcmMs: Long? = null,
+        val decodedPositionMs: Long? = null,
+        val seekPositionMs: Long? = null,
+        val error: String? = null,
+    )
+
+    private class TransformTracker {
+        private var cipherFormats = 0
+        private var nFormats = 0
+        private var cipherTransformed = false
+        private var nTransformed = false
+
+        fun begin() {
+            cipherFormats = 0
+            nFormats = 0
+            cipherTransformed = false
+            nTransformed = false
+        }
+
+        fun observe(
+            tag: String,
+            message: String,
+        ) {
+            if (tag != "YouTubeCipherService") return
+            if (message.startsWith("processFormats start")) {
+                cipherFormats = maxOf(cipherFormats, number(message, "cipherFormats"))
+                nFormats = maxOf(nFormats, number(message, "nFormats"))
+            }
+            if (message.startsWith("signature ") && (message.contains("done") || message.contains("reused"))) {
+                cipherTransformed = true
+            }
+            if (message.startsWith("n ") && (message.contains("done") || message.contains("reused"))) {
+                nTransformed = true
+            }
+        }
+
+        fun snapshot(): TransformSnapshot =
+            TransformSnapshot(
+                nStatus =
+                    when {
+                        nFormats == 0 -> "none-observed"
+                        nTransformed -> "transformed"
+                        else -> "observed-unconfirmed"
+                    },
+                cipherStatus =
+                    when {
+                        cipherFormats == 0 -> "none-observed"
+                        cipherTransformed -> "transformed"
+                        else -> "observed-unconfirmed"
+                    },
+            )
+
+        private fun number(
+            message: String,
+            key: String,
+        ): Int =
+            Regex("\\b$key=(\\d+)")
+                .find(message)
+                ?.groupValues
+                ?.get(1)
+                ?.toIntOrNull() ?: 0
+    }
+
+    private data class TransformSnapshot(
+        val nStatus: String,
+        val cipherStatus: String,
+    )
+
