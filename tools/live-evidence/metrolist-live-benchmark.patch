+    private suspend fun runOne(
+        httpClient: HttpClient,
+        resolver: DefaultStreamResolver,
+        tracker: TransformTracker,
+        type: String,
+        iteration: Int,
+        processPhase: String,
+        profilePhase: String,
+        videoId: String,
+        hints: ContentHints,
+        decode: Boolean,
+    ): Row =
+        withTimeoutOrNull(SAMPLE_TIMEOUT_MS) {
+            runOneWithinDeadline(
+                httpClient = httpClient,
+                resolver = resolver,
+                tracker = tracker,
+                type = type,
+                iteration = iteration,
+                processPhase = processPhase,
+                profilePhase = profilePhase,
+                videoId = videoId,
+                hints = hints,
+                decode = decode,
+            )
+        } ?: Row(type, iteration, processPhase, profilePhase, error = "sample:timeout")
+
+    private suspend fun runOneWithinDeadline(
+        httpClient: HttpClient,
+        resolver: DefaultStreamResolver,
+        tracker: TransformTracker,
+        type: String,
+        iteration: Int,
+        processPhase: String,
+        profilePhase: String,
+        videoId: String,
+        hints: ContentHints,
+        decode: Boolean,
+    ): Row {
+        tracker.begin()
+        val started = TimeSource.Monotonic.markNow()
+        var stage = "resolve"
+        return try {
+            val resource =
+                withTimeoutOrNull(RESOLVE_TIMEOUT_MS) { resolver.resolve(videoId, hints, AudioQuality.HIGH) }
+                    ?: error("resolution deadline exceeded")
+            val resolvedMs = started.elapsedNow().inWholeMilliseconds
+            stage = "first-media"
+            val mediaStarted = TimeSource.Monotonic.markNow()
+            val media = probeFirstMedia(httpClient, resource)
+            val firstMediaMs = mediaStarted.elapsedNow().inWholeMilliseconds
+            val totalFirstMediaMs = started.elapsedNow().inWholeMilliseconds
+            stage = "repeat-resolve"
+            val cacheStarted = TimeSource.Monotonic.markNow()
+            checkNotNull(withTimeoutOrNull(RESOLVE_TIMEOUT_MS) { resolver.resolve(videoId, hints, AudioQuality.HIGH) }) {
+                "repeat resolution deadline exceeded"
+            }
+            val cacheMs = cacheStarted.elapsedNow().inWholeMilliseconds
+            stage = "decode"
+            val decoded = if (decode) decodeAudio(httpClient, resource) else DecodeProbe()
+            val attempts =
+                resource.streamDiagnostics
+                    ?.attempts
+                    .orEmpty()
+                    .filterNot { it.outcome.startsWith("selection:") }
+            Row(
+                type = type,
+                iteration = iteration,
+                processPhase = processPhase,
+                profilePhase = profilePhase,
+                resolveMs = resolvedMs,
+                firstMediaMs = firstMediaMs,
+                timeToFirstMediaMs = totalFirstMediaMs,
+                cacheMs = cacheMs,
+                client = resource.clientName,
+                profile = resource.profileId,
+                transport = if (resource.isSabr) "SABR" else "DIRECT",
+                itag = resource.itag,
+                mimeType = resource.mimeType,
+                codecs = resource.codecs,
+                bitrate = resource.bitrate,
+                sampleRate = resource.sampleRate ?: decoded.sampleRate,
+                audioChannels = decoded.channels,
+                mediaStatus = media.status,
+                decodedFirstPcmMs = decoded.firstPcmMs,
+                decoded30sMs = decoded.fullDecodeMs,
+                seekFirstPcmMs = decoded.seekFirstPcmMs,
+                decodedPositionMs = decoded.decodedPositionMs,
+                seekPositionMs = decoded.seekPositionMs,
+                nTransform = tracker.snapshot().nStatus,
+                cipherTransform = tracker.snapshot().cipherStatus,
+                usedPoToken = resource.profileId.endsWith("__po"),
+                authWatch = resource.streamDiagnostics?.usedAuthenticatedWatchPage == true,
+                attempts = attempts.size,
+                hops = (attempts.size - 1).coerceAtLeast(0),
+                error = decoded.error,
+            )
+        } catch (error: CancellationException) {
+            throw error
+        } catch (error: Throwable) {
+            Row(
+                type = type,
+                iteration = iteration,
+                processPhase = processPhase,
+                profilePhase = profilePhase,
+                resolveMs = started.elapsedNow().inWholeMilliseconds,
+                error = "$stage:${error::class.simpleName ?: "Throwable"}",
+            )
+        }
+    }
