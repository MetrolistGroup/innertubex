+    private suspend fun probeAuthentication(innerTube: com.metrolist.innertubex.InnerTube): AuthProbe {
+        val credentialsPresent = innerTube.hasSapCookieAuth()
+        return try {
+            val response = innerTube.accountMenu(YouTubeClient.WEB_REMIX)
+            val status = response.status.value
+            val accountMenuObserved =
+                status in 200..299 && parseAccountInfoResponse(response.bodyAsTextLimited(MAX_ACCOUNT_MENU_BYTES)) != null
+            AuthProbe(credentialsPresent, status, accountMenuObserved)
+        } catch (error: CancellationException) {
+            throw error
+        } catch (_: Throwable) {
+            AuthProbe(credentialsPresent, null, false)
+        }
+    }
+
+    private fun applyPremiumHint(
+        hints: ContentHints,
+        requested: Boolean,
+    ): ContentHints {
+        if (!requested) return hints
+        val method: Method =
+            hints.javaClass.methods.firstOrNull {
+                it.name == "withPremium" &&
+                    it.parameterCount == 1 &&
+                    it.parameterTypes[0] == Boolean::class.javaPrimitiveType
+            } ?: return hints
+        return runCatching { method.invoke(hints, true) as? ContentHints }.getOrNull() ?: hints
+    }
+
